---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const updates = (await getCollection('updates', ({data}) => !data.draft && data.date <= new Date())).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base>
<section class="hero"><p class="eyebrow">THE INDEPENDENT WORKSHOP</p><h1>Build useful things.<br/><span>Share what you learn.</span></h1><p class="lead">Technology, creative work, and lessons from the workbench. A home for what we’re making—and what comes next.</p><a class="button" href="#work">Explore the work <span aria-hidden="true">↓</span></a></section>
<section id="work" class="work"><div class="section-heading"><p class="eyebrow">ON THE WORKBENCH</p><span class="muted">01 / Creative work</span></div><div class="feature"><div class="orbit" aria-hidden="true"><div class="planet"></div><span>COZY<br/>SPACE BARD</span><i>TRANSMISSIONS FROM A QUIETER CORNER</i></div><div class="feature-copy"><p class="eyebrow">ON YOUTUBE</p><h2>Cozy Space Bard</h2><p>A different corner of the Steel &amp; Code workshop. Explore the channel and watch the latest releases on YouTube.</p><a class="button" href="https://www.youtube.com/@CozySpaceBard">Visit the channel ↗</a><a class="text-link" href="/cozy-space-bard/">More about Cozy Space Bard →</a></div></div></section>
<section class="projects"><div class="section-heading"><h2>Engineering, in the open.</h2><span class="muted">02 / Projects</span></div>
<article class="os-feature"><a class="project-art" href="https://steel-os.org/"><img src="/images/steel-os-desktop.webp" alt="Steel OS desktop showing its terminal, browser, and file manager" width="1400" height="871" loading="lazy"/></a><div class="project-copy"><img class="os-icon" src="/images/steel-os-icon.png" alt="" width="128" height="128" loading="lazy"/><p class="eyebrow">FOUNDATION / PREVIEW</p><h3>Steel OS</h3><p>A free desktop operating system for people who want their PC to just work. Built on Bazzite and Fedora.</p><a href="https://steel-os.org/">Explore Steel OS ↗</a></div></article>
<div class="art-grid"><article class="art-card"><a class="project-art" href="https://github.com/steel-and-code/steel-and-code-forge"><img src="/images/forge-build.webp" alt="Forge concept artwork: a network of AI agents connected to a central system" width="1000" height="750" loading="lazy"/></a><div class="project-copy"><p class="eyebrow">INTELLIGENCE / EARLY ALPHA</p><h3>Forge</h3><p>An open-source AI agent platform: specialists working from one terminal.</p><a href="https://github.com/steel-and-code/steel-and-code-forge">Explore Forge ↗</a><small>Concept artwork</small></div></article><article class="art-card"><div class="project-art"><img src="/images/outpost-build.webp" alt="Outpost concept artwork: an engineering command center with multiple terminal screens" width="1000" height="750" loading="lazy"/></div><div class="project-copy"><p class="eyebrow">COMMAND CENTER / IN DEVELOPMENT</p><h3>Outpost</h3><p>A terminal built for the job, with a graphical command center. A fork of Konsole with an engineering-first interface.</p><small>Concept artwork</small></div></article></div></section>
<section class="projects"><div class="section-heading"><h2>Explore, out loud.</h2><span class="muted">03 / Experiments</span></div><article class="art-card steelcast"><img src="/images/steelcast-explore.png" alt="Steelcast artwork: a space station observation deck overlooking Earth" width="1600" height="533" loading="lazy"/><div class="project-copy"><p class="eyebrow">STEELCAST / IN DEVELOPMENT</p><h3>Experiments in engineering.</h3><p>Ideas, prototypes, and lessons learned as we work through them.</p></div></article></section>
<section class="projects"><div class="section-heading"><h2>Learn by building.</h2><span class="muted">04 / Teaching tools</span></div><div class="art-grid"><article class="art-card"><a class="project-art tool-art" href="https://www.steelandcode.com/workbench/"><img src="/images/workbench-teach.png" alt="The Steel and Code Workbench with a lesson, Python editor, and output panel" width="1286" height="838" loading="lazy"/></a><div class="project-copy"><h3>Workbench</h3><p>Guided lessons and a Python editor, together in your browser.</p><a href="https://www.steelandcode.com/workbench/">Open Workbench ↗</a></div></article><article class="art-card"><a class="project-art tool-art" href="https://www.steelandcode.com/lab/"><img src="/images/python-lab-teach.png" alt="The Steel and Code Python Lab with its editor and output panel" width="1286" height="838" loading="lazy"/></a><div class="project-copy"><h3>Python Lab</h3><p>Write code, run an experiment, and explore Python in your browser.</p><a href="https://www.steelandcode.com/lab/">Open Python Lab ↗</a></div></article></div></section>
{updates.length > 0 && <section class="updates"><div class="section-heading"><h2>Latest from the workshop.</h2></div>{updates.map(note=><article class="project-row"><div><p class="eyebrow">{note.data.date.toISOString().slice(0,10)}</p><h3><a href={`/updates/${note.id}/`}>{note.data.title}</a></h3><p>{note.data.summary}</p></div><a href={`/updates/${note.id}/`} aria-label={`Read ${note.data.title}`}>Read →</a></article>)}</section>}
<section class="closing"><p class="eyebrow">BUILD. EXPLORE. TEACH.</p><h2>Good work starts with curiosity.</h2><a href="/about/">Meet Steel &amp; Code →</a></section>
</Base>
