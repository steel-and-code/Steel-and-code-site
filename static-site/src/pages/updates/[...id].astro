---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
 const notes = await getCollection('updates', ({data})=>!data.draft && data.date <= new Date());
 return notes.map(note=>({params:{id:note.id},props:{note}}));
}
const {note}=Astro.props;
const {Content}=await render(note);
---
<Base title={`${note.data.title} | Steel & Code`} description={note.data.summary}><article><div class="page-head"><p class="eyebrow">FROM THE WORKSHOP / <time datetime={note.data.date.toISOString()}>{note.data.date.toISOString().slice(0,10)}</time></p><h1>{note.data.title}</h1><p class="lead">{note.data.summary}</p>{note.data.youtubeId && <a class="button" href={`https://www.youtube.com/watch?v=${note.data.youtubeId}`}>Watch on YouTube ↗</a>}</div><div class="prose"><Content/></div></article></Base>
