---
import Base from '../layouts/Base.astro';
import { tutoringContactHref, tutoringEmailAddress } from '../tutoring';
---

<Base
  title="Online Python, SQL & AI Tutoring | Steel & Code"
  description="One-on-one online tutoring in Python, SQL, and AI for college students and adult beginners. Introductory rate: $45 per 60-minute session."
  noindex={!tutoringContactHref}
>
  <section class="page-head tutoring-intro" aria-labelledby="tutoring-title">
    <div>
      <p class="eyebrow">ONLINE · ONE-ON-ONE</p>
      <h1 id="tutoring-title">Python, SQL &amp; AI tutoring</h1>
      <p class="lead">Taking your first college programming class or learning on your own? Get patient, practical help at your pace, whether you’re writing code, working with data, or figuring out how to use AI tools.</p>
    </div>
    <div class="session-card">
      <p class="eyebrow">INTRODUCTORY RATE</p>
      <p class="price"><strong>$45</strong> <span>per 60-minute session</span></p>
      <a class="button" href="#request">{tutoringContactHref ? 'Request a session' : 'Session details'} <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="tutoring-details" aria-labelledby="topics-title">
    <p class="eyebrow">01 / WHAT YOU CAN LEARN</p>
    <h2 id="topics-title">Choose what to work on</h2>
    <div class="topic-grid">
      <article class="topic">
        <h3>Python</h3>
        <p>Run your first script, practice variables, loops, and functions, and learn how to read errors and debug small programs.</p>
      </article>
      <article class="topic">
        <h3>SQL</h3>
        <p>Write queries to filter and sort data, combine tables with joins, and summarize results with grouping and counts.</p>
      </article>
      <article class="topic">
        <h3>AI</h3>
        <p>Learn what AI tools can and can’t do, write clearer prompts, and check their answers before using them in everyday tasks.</p>
      </article>
    </div>
  </section>

  <section class="tutoring-details" aria-labelledby="approach-title">
    <p class="eyebrow">02 / HOW WE WORK</p>
    <h2 id="approach-title">Practice with support</h2>
    <p>Bring a question, some code, or a goal. We’ll work through an example together, then you’ll try it yourself. You’ll leave with a next step to practice on your own.</p>
    <p><strong>For coursework:</strong> I can explain concepts, review your reasoning, and help you debug your own work within your course rules, including any rules on AI use. I don’t write or submit graded work or take quizzes or exams for you.</p>
  </section>

  <section id="request" class="closing request" aria-labelledby="request-title">
    <p class="eyebrow">03 / GET STARTED</p>
    <h2 id="request-title">Request a session</h2>
    {tutoringContactHref ? (
      <>
        <p class="lead">Tell me which topic you’d like help with, your time zone, and a few times that work for you. I’ll reply to find a time together.</p>
        <a class="button" href={tutoringContactHref}>{tutoringEmailAddress ? 'Email to request a session' : 'Send a tutoring inquiry'} <span aria-hidden="true">↗</span></a>
        {tutoringEmailAddress && <p class="muted contact-address">{tutoringEmailAddress}</p>}
      </>
    ) : (
      <p class="lead">Session requests aren’t open yet.</p>
    )}
  </section>
</Base>

<style>
  .tutoring-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(26px, 5vw, 72px);
    align-items: center;
  }
  .tutoring-intro .lead { margin-bottom: 0; }
  .session-card {
    padding: clamp(22px, 4vw, 42px);
    background: #172630;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
  }
  .price { margin: 0 0 26px; color: var(--muted); }
  .price strong {
    display: block;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.05em;
    color: var(--ink);
  }
  .tutoring-details {
    padding-top: 38px;
    border-top: 1px solid var(--line);
  }
  .tutoring-details + .tutoring-details { margin-top: 42px; }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .topic {
    padding: clamp(18px, 3vw, 30px);
    border: 1px solid var(--line);
    background: #172630;
  }
  .tutoring-details p:not(.eyebrow) {
    max-width: 720px;
    color: var(--muted);
    line-height: 1.75;
    margin: 0 0 14px;
  }
  .tutoring-details .topic p { margin: 0; }
  .tutoring-details strong { color: var(--ink); }
  .request { scroll-margin-top: 20px; }
  .request .lead { max-width: 650px; }
  .contact-address { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .tutoring-intro, .topic-grid { grid-template-columns: 1fr; }
  }
</style>
