---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const videos = (await getCollection('updates', ({data}) => !data.draft && data.date <= new Date() && Boolean(data.youtubeId))).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Cozy Space Bard | Steel & Code" description="Explore Cozy Space Bard on YouTube. New releases and updates from the channel."><section class="page-head"><p class="eyebrow">A CORNER OF THE WORKSHOP</p><h1>Cozy Space Bard</h1><p class="lead">The channel, the releases, and a little space to explore.</p><a class="button" href="https://www.youtube.com/@CozySpaceBard">Watch on YouTube ↗</a></section><div class="banner orbit" aria-hidden="true"><div class="planet"></div><span>MAKE ROOM<br/>FOR A LITTLE SPACE.</span></div><section class="prose"><h2>Find the latest on YouTube.</h2><p>Visit Cozy Space Bard for the full collection of videos and subscribe there to hear about new releases.</p><a href="https://www.youtube.com/@CozySpaceBard/videos">Browse all videos ↗</a></section>{videos.length > 0 && <section><h2>Release notes</h2>{videos.map(video=><article class="project-row"><div><h3><a href={`/updates/${video.id}/`}>{video.data.title}</a></h3><p>{video.data.summary}</p></div><a href={`https://www.youtube.com/watch?v=${video.data.youtubeId}`}>Watch ↗</a></article>)}</section>}</Base>
